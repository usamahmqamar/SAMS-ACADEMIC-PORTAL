{
  "version": 2,
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "includeFiles": "school_db.json",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
